# PostgreSQL 备份与隔离恢复专用配置
#
# 只注入独立 ops 进程。禁止注入 Flask、Gunicorn、frontend 或健康检查。
# 所有凭证由 secret manager 或受控主机配置提供；不要把真实值提交到仓库。

# 只读备份角色：最小化为 CONNECT/USAGE/SELECT 和 pg_dump 所需权限。
BACKUP_DB_HOST=source-postgres.example.invalid
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=image_search
BACKUP_DB_USER=backup_reader
BACKUP_DB_PASSWORD=replace-via-secret-manager

# 本机副本；目录和文件分别使用 0700/0600。
BACKUP_ROOT=./backups
BACKUP_DAILY_TIMEZONE=Asia/Shanghai

# 独立私有备份 Bucket；必须不同于 OSS_BUCKET_NAME 和应用凭证。
# IAM 仅允许指定前缀的 Put/Head/Get，不允许 Delete/ACL/生命周期管理。
BACKUP_OSS_ACCESS_KEY_ID=replace-via-secret-manager
BACKUP_OSS_ACCESS_KEY_SECRET=replace-via-secret-manager
BACKUP_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
BACKUP_OSS_BUCKET_NAME=private-database-backups-example
BACKUP_OSS_BASE_PREFIX=postgresql-backups
BACKUP_OSS_SSE=AES256

# 永久清除对象备份读取正式图片的专用只读角色。
# 必须显式配置；禁止回退 OSS_* 应用凭证，IAM 只允许 Head/Get。
PURGE_SOURCE_OSS_ACCESS_KEY_ID=source-read-role-example
PURGE_SOURCE_OSS_ACCESS_KEY_SECRET=replace-source-read-via-secret-manager
PURGE_SOURCE_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
PURGE_SOURCE_OSS_BUCKET_NAME=private-image-assets-example

# 永久清除对象仅恢复到一次性隔离 Bucket 的专用写入角色。
# Bucket/凭证必须与应用、正式源和备份角色全部不同；不允许 Delete。
PURGE_RESTORE_OSS_ACCESS_KEY_ID=isolation-write-role-example
PURGE_RESTORE_OSS_ACCESS_KEY_SECRET=replace-isolation-write-via-secret-manager
PURGE_RESTORE_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
PURGE_RESTORE_OSS_BUCKET_NAME=disposable-image-restore-example
PURGE_RESTORE_OSS_BASE_PREFIX=isolated-restores
PURGE_RESTORE_OSS_SSE=AES256
PURGE_RESTORE_ISOLATED=0
PURGE_RESTORE_TEMP_ROOT=./backups/.purge-object-restore

# 隔离 PostgreSQL 管理角色；只用于显式恢复验证，不能复用备份角色。
RESTORE_VERIFY_DB_HOST=disposable-pgvector.example.invalid
RESTORE_VERIFY_DB_PORT=5432
RESTORE_VERIFY_DB_NAME=postgres
RESTORE_VERIFY_DB_USER=restore_admin
RESTORE_VERIFY_DB_PASSWORD=replace-via-secret-manager
RESTORE_VERIFY_DISPOSABLE=0
RESTORE_VERIFY_TEMP_ROOT=./backups/.restore-verify

# 真实 disposable 集成接缝默认关闭；获授权演练时才可显式设为 1。
# 集成测试会在独立源实例创建随机 backup_source_* 数据库并写入固定样本，
# 不会自动删除。此管理员角色不得指向生产实例。
RUN_DISPOSABLE_BACKUP_RESTORE_TEST=0
DISPOSABLE_SOURCE_ADMIN_DB_HOST=disposable-source-pgvector.example.invalid
DISPOSABLE_SOURCE_ADMIN_DB_PORT=5432
DISPOSABLE_SOURCE_ADMIN_DB_NAME=postgres
DISPOSABLE_SOURCE_ADMIN_DB_USER=disposable_admin
DISPOSABLE_SOURCE_ADMIN_DB_PASSWORD=replace-via-secret-manager

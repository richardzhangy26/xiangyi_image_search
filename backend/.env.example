# ============================================
# Supabase Database Configuration (推荐)
# ============================================
# 从 Supabase Dashboard -> Settings -> Database 获取
#
# DIRECT_URL: 直连数据库（适用于迁移、长事务、管理任务）
#   格式: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# DATABASE_URL: 连接池方式（推荐用于应用运行时，性能更好）
#   格式: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# ⚠️ 重要：密码中的特殊字符需要 URL 编码
#   例如: ! -> %21, @ -> %40, # -> %23, $ -> %24, % -> %25
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase API Configuration (可选，用于 Storage 等功能)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ============================================
# 本地 PostgreSQL Configuration (备用)
# ============================================
# 如果不使用 Supabase，可以使用本地 PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=image_search
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Alternative: MySQL Configuration (Legacy)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=xiangyipackage_test
# DB_USER=root
# DB_PASSWORD=your_password_here

# ============================================
# AI Services Configuration
# ============================================
# DashScope API (Required for image embeddings)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Aliyun OSS Storage (Optional)
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=your_bucket_name
# OSS_UPLOAD_BASE_PATH=/path/to/local/images

# Additional AI Services (Optional)
# OPENAI_API_KEY=your_openai_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# ============================================
# Dataset Configuration
# ============================================
# DATASET_ROOT=./data/摄像师拍摄素材
# ============================================
# 本地 PostgreSQL Configuration (pgvector)
# ============================================
# 使用 docker-compose 启动的 PostgreSQL 时，宿主机端口为 5433
# 也可以直接提供完整连接串 DATABASE_URL（优先级高于 DB_* 变量）
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5433/image_search
DB_HOST=localhost
DB_PORT=5433
DB_NAME=image_search
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================
# AI Services Configuration
# ============================================
# DashScope API (Required for image embeddings)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Qiniu Kodo Source (Kodo 只读迁移来源；仅供 migrate_kodo_to_oss 读取，绝不作为公开 URL 源)
QINIU_ACCESS_KEY=your_qiniu_access_key_here
QINIU_SECRET_KEY=your_qiniu_secret_key_here
QINIU_BUCKET_NAME=xiangxipackage
QINIU_REGION=z0
# Get Service 无法唯一映射原始 bucket 名称时才需要
# QINIU_S3_BUCKET_NAME=globally-unique-s3-bucket-name

# Aliyun OSS Target (Required for image asset ingest and private preview)
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=your_private_bucket_name
OSS_IMAGE_BASE_PREFIX=image-search
# 签名 URL 时间窗口长度（秒）：窗口内同一图片的签名 URL 稳定，浏览器缓存 302 与 OSS 响应
OSS_SIGNED_URL_TTL_SECONDS=3600

# Canonical search preview normalization
IMAGE_PREVIEW_MAX_EDGE=2048
IMAGE_PREVIEW_MAX_MB=2.5
IMAGE_MAX_PIXELS=100000000
IMAGE_NORMALIZATION_VERSION=preview-v1

# Additional AI Services (Optional)
# OPENAI_API_KEY=your_openai_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key

# ============================================
# Dataset Configuration
# ============================================
# 本地图片目录不属于正式图片工作流；迁移请使用 scripts.migrate_kodo_to_oss。

# ============================================
# Permanent purge control plane (optional)
# Unset keeps the gate closed. Do not put a real token here.
# ============================================
# PURGE_ADMIN_TOKEN=
# PURGE_ADMIN_ACTOR_ID=admin
# PURGE_GATE_EVIDENCE_DIR=
